 maintenance schedule rule","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateScheduleDto"}}}},"responses":{"201":{"description":""}},"tags":["Maintenance Schedules"]}},"/api/schedules/trigger-due-check":{"post":{"operationId":"SchedulesController_triggerCheck","summary":"Manually trigger the preventative maintenance evaluation worker","parameters":[],"responses":{"201":{"description":""}},"tags":["Maintenance Schedules"]}},"/api/parts":{"get":{"operationId":"SparePartsController_findAll","summary":"List spare parts inventory with optional low-stock alert filter","parameters":[{"name":"lowStockOnly","required":false,"in":"query","schema":{"type":"boolean"}}],"responses":{"200":{"description":""}},"tags":["Spare Parts"]},"post":{"operationId":"SparePartsController_create","summary":"Add a new spare part to inventory","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePartDto"}}}},"responses":{"201":{"description":""}},"tags":["Spare Parts"]}},"/api/parts/{id}":{"get":{"operationId":"SparePartsController_findOne","summary":"Get single spare part details","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["Spare Parts"]}},"/api/technicians":{"get":{"operationId":"TechniciansController_findAll","summary":"List all active technicians with active work order count","parameters":[],"responses":{"200":{"description":""}},"tags":["Technicians"]}},"/api/technicians/{id}":{"get":{"operationId":"TechniciansController_findOne","summary":"Get single technician profile and assigned work orders","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["Technicians"]}}},"info":{"title":"OpsTrack CMMS API","description":"Enterprise Computerized Maintenance Management System API specification