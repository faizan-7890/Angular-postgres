generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model assets {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                   @db.VarChar(150)
  serial_number         String                   @unique @db.VarChar(100)
  category              String                   @db.VarChar(100)
  location              String                   @db.VarChar(150)
  status                asset_status?            @default(OPERATIONAL)
  purchase_date         DateTime?                @db.Date
  warranty_expires_at   DateTime?                @db.Date
  specs                 Json?                    @default("{}")
  search_vector         Unsupported("tsvector")?
  created_at            DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?                @default(now()) @db.Timestamptz(6)
  maintenance_schedules maintenance_schedules[]
  work_orders           work_orders[]

  @@index([search_vector], map: "idx_assets_search_vector", type: Gin)
  @@index([status], map: "idx_assets_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model maintenance_schedules {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id                String        @db.Uuid
  task_name               String        @db.VarChar(200)
  frequency_interval_days Int
  next_due_date           DateTime      @db.Date
  last_completed_at       DateTime?     @db.Timestamptz(6)
  created_at              DateTime?     @default(now()) @db.Timestamptz(6)
  assets                  assets        @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  work_orders             work_orders[]

  @@index([next_due_date], map: "idx_schedules_next_due_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spare_parts {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(150)
  sku              String             @unique @db.VarChar(80)
  stock_quantity   Int                @default(0)
  min_threshold    Int                @default(5)
  unit_cost        Decimal            @default(0.00) @db.Decimal(10, 2)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  work_order_parts work_order_parts[]

  @@index([sku], map: "idx_spare_parts_sku")
}

model technicians {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name   String        @db.VarChar(100)
  email       String        @unique @db.VarChar(150)
  phone       String?       @db.VarChar(30)
  role        String?       @default("General Technician") @db.VarChar(50)
  is_active   Boolean?      @default(true)
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  work_orders work_orders[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model work_order_parts {
  work_order_id String      @db.Uuid
  part_id       String      @db.Uuid
  quantity_used Int
  spare_parts   spare_parts @relation(fields: [part_id], references: [id], onUpdate: NoAction)
  work_orders   work_orders @relation(fields: [work_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([work_order_id, part_id])
}

model work_orders {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                  String                 @db.VarChar(200)
  description            String?
  priority               work_order_priority?   @default(MEDIUM)
  status                 work_order_status?     @default(PENDING)
  asset_id               String                 @db.Uuid
  assigned_technician_id String?                @db.Uuid
  schedule_id            String?                @db.Uuid
  scheduled_date         DateTime?              @default(dbgenerated("CURRENT_DATE")) @db.Date
  completed_at           DateTime?              @db.Timestamptz(6)
  created_at             DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?              @default(now()) @db.Timestamptz(6)
  work_order_parts       work_order_parts[]
  assets                 assets                 @relation(fields: [asset_id], references: [id], onUpdate: NoAction)
  technicians            technicians?           @relation(fields: [assigned_technician_id], references: [id], onUpdate: NoAction)
  maintenance_schedules  maintenance_schedules? @relation(fields: [schedule_id], references: [id], onUpdate: NoAction)

  @@index([asset_id], map: "idx_work_orders_asset_id")
  @@index([status], map: "idx_work_orders_status")
  @@index([assigned_technician_id], map: "idx_work_orders_technician")
}

enum asset_status {
  OPERATIONAL
  UNDER_MAINTENANCE
  DECOMMISSIONED
  IN_STORAGE
}

enum work_order_priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum work_order_status {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
